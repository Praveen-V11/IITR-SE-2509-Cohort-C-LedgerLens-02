# Copy this to .env and fill in your own key. Never commit the real .env.
OPENAI_API_KEY=sk-your-key-here

# Model selection
LEDGERLENS_VISION_MODEL=gpt-4o
LEDGERLENS_MODERATION_MODEL=omni-moderation-latest

# Confidence routing - fields below this are sent to the review queue
LEDGERLENS_REVIEW_THRESHOLD=0.75

# Moderation - category score at/above this blocks the upload
LEDGERLENS_MOD_BLOCK_THRESHOLD=0.5

# Storage
LEDGERLENS_DB_URL=sqlite:///./ledgerlens.db
LEDGERLENS_UPLOAD_DIR=uploads

# Image preprocessing
LEDGERLENS_MAX_IMG_DIM=2048

# Approximate cost figures, USD per 1K tokens (only used for the Grafana cost panel)
LEDGERLENS_COST_INPUT=0.0025
LEDGERLENS_COST_OUTPUT=0.01

LEDGERLENS_ENV=local

# Used by streamlit_app.py to find the API - override to http://api:8000 under docker-compose
LEDGERLENS_API_BASE=http://localhost:8000
